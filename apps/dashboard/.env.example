# Public URL Shopify redirects back to. Use an HTTPS tunnel in local development.
APP_URL=https://your-app.example.com

# PostgreSQL. Set DATABASE_SSL=true for providers that require TLS.
# Certificate verification stays on. Only set DATABASE_SSL_REJECT_UNAUTHORIZED=false
# if a provider cannot present a publicly trusted certificate.
DATABASE_URL=postgresql://user:password@localhost:5432/cohorio
DATABASE_SSL=false
# DATABASE_SSL_REJECT_UNAUTHORIZED=false
# Optional isolated database for integration tests. Never point this at production.
TEST_DATABASE_URL=
RUN_DB_INTEGRATION_TESTS=false

# Authentication. Generate AUTH_SECRET with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
AUTH_URL=https://cohorio-production.up.railway.app
# Set true only behind a trusted reverse proxy (Railway, nginx). Rate limits then
# use the last X-Forwarded-For hop. Leave false for direct local access.
AUTH_TRUST_PROXY=false

# Google OAuth credentials. AUTH_GOOGLE_* is preferred; GOOGLE_OAUTH_* is accepted.
# Authorized origin: https://your-app.example.com
# Authorized redirect URI: https://your-app.example.com/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Transactional authentication email (Resend).
RESEND_API_KEY=
AUTH_EMAIL_FROM=Cohorio <accounts@your-app.example.com>

# Shopify app credentials from the Dev Dashboard (Client ID / Client secret).
# Client secrets often start with shpss_. Do not paste an Admin API access
# token (shpat_, shpua_, or shpca_).
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_SCOPES=read_products,write_products,read_inventory,read_orders,read_customers,read_analytics,read_reports

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep this stable. Losing it makes stored Shopify tokens unreadable.
SHOPIFY_TOKEN_ENCRYPTION_KEY=

# OpenAI-compatible chat completions. Leave the key empty to fail closed.
COHORIO_LLM_API_KEY=
COHORIO_LLM_BASE_URL=https://api.openai.com/v1
COHORIO_LLM_MODEL=gpt-4.1-mini

