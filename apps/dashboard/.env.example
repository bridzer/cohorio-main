# Public URL Shopify redirects back to. Use an HTTPS tunnel in local development.
APP_URL=https://your-app.example.com

# PostgreSQL. Set DATABASE_SSL=true for providers that require TLS.
# Certificate verification stays on. Only set DATABASE_SSL_REJECT_UNAUTHORIZED=false
# if a provider cannot present a publicly trusted certificate.
DATABASE_URL=postgresql://user:password@localhost:5432/cohorio
DATABASE_SSL=false
# DATABASE_SSL_REJECT_UNAUTHORIZED=false
# Optional isolated database for integration tests. Never point this at production.
TEST_DATABASE_URL=
RUN_DB_INTEGRATION_TESTS=false

# Authentication. Generate AUTH_SECRET with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
AUTH_URL=https://cohorio-production.up.railway.app
# Set true only behind a trusted reverse proxy (Railway, nginx). Rate limits then
# use the last X-Forwarded-For hop. Leave false for direct local access.
AUTH_TRUST_PROXY=false

# Google OAuth credentials. AUTH_GOOGLE_* is preferred; GOOGLE_OAUTH_* is accepted.
# Authorized origin: https://your-app.example.com
# Authorized redirect URI: https://your-app.example.com/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Transactional authentication email (Resend).
RESEND_API_KEY=
AUTH_EMAIL_FROM=Cohorio <accounts@your-app.example.com>

# Shopify app credentials from the Dev Dashboard (Client ID / Client secret).
# Client secrets often start with shpss_. Do not paste an Admin API access
# token (shpat_, shpua_, or shpca_).
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_SCOPES=read_products,write_products,read_inventory,read_orders,read_customers,read_analytics,read_reports

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep this stable. Losing it makes stored Shopify tokens unreadable.
SHOPIFY_TOKEN_ENCRYPTION_KEY=

# Language model. Leave the key empty to fail closed.
# COHORIO_LLM_PROVIDER: "anthropic" (Claude via the Anthropic SDK) or
# "openai-compatible" (any chat-completions API at COHORIO_LLM_BASE_URL, e.g.
# Groq or OpenRouter). Unset, an Anthropic key (sk-ant-...) selects anthropic.
COHORIO_LLM_PROVIDER=anthropic
COHORIO_LLM_API_KEY=
# Claude model id; defaults to claude-opus-5-5 when empty.
COHORIO_LLM_MODEL=claude-opus-5-5
# Claude thinking effort: low | medium | high | xhigh | max (default medium).
COHORIO_LLM_EFFORT=medium
# Only used by the openai-compatible provider.
COHORIO_LLM_BASE_URL=


# Optional OpenAI-compatible image generation for Social Studio "Add a visual".
# Server-only. Leave the key empty to fail closed; post text still generates.
COHORIO_IMAGE_API_KEY=
COHORIO_IMAGE_BASE_URL=https://api.openai.com/v1
COHORIO_IMAGE_MODEL=dall-e-3

# Optional Stripe billing for the Pro ($49/mo) and Team ($149/mo) plans.
# Server-only. With these empty every workspace stays on the free plan.
# Point the Stripe webhook at ${APP_URL}/api/billing/webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Background worker for scheduled agent automations and approval emails.
# Runs inside the Next.js server process when true. Keep it off on local dev
# servers that share a database with production. Several instances may run it:
# jobs are claimed with row locks, so each job runs once.
COHORIO_WORKER_ENABLED=false
# Poll interval in milliseconds (minimum 5000).
COHORIO_WORKER_INTERVAL_MS=15000
