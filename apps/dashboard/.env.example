# Public URL Shopify redirects back to. Use an HTTPS tunnel in local development.
APP_URL=https://your-app.example.com

# PostgreSQL. Set DATABASE_SSL=true for providers that require TLS.
# Certificate verification stays on. Only set DATABASE_SSL_REJECT_UNAUTHORIZED=false
# if a provider cannot present a publicly trusted certificate.
DATABASE_URL=postgresql://user:password@host:5432/database
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=false
# Optional isolated database for integration tests. Never point this at production.
TEST_DATABASE_URL=
RUN_DB_INTEGRATION_TESTS=false

# Authentication. Generate AUTH_SECRET with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
AUTH_URL=https://cohorio-production.up.railway.app
# Set true only behind a trusted reverse proxy (Railway, nginx). Rate limits then
# use the last X-Forwarded-For hop. Leave false for direct local access.
AUTH_TRUST_PROXY=false

# Google OAuth credentials. AUTH_GOOGLE_* is preferred; GOOGLE_OAUTH_* is accepted.
# Authorized origin: https://your-app.example.com
# Authorized redirect URIs: https://your-app.example.com/api/auth/callback/google
# (sign-in) and https://your-app.example.com/api/integrations/ga4/oauth/callback
# (GA4 "Connect with Google"; the same client refreshes GA4/Google Ads tokens).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Transactional authentication email (Resend).
RESEND_API_KEY=
AUTH_EMAIL_FROM=Cohorio <accounts@your-app.example.com>

# Shopify app credentials from the Dev Dashboard (Client ID / Client secret).
# Client secrets often start with shpss_. Do not paste an Admin API access
# token (shpat_, shpua_, or shpca_).
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_SCOPES=read_products,write_products,read_inventory,read_orders,read_customers,read_analytics,read_reports

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep this stable. Losing it makes stored Shopify tokens unreadable.
SHOPIFY_TOKEN_ENCRYPTION_KEY=

# Language model. Leave the key empty to fail closed.
# COHORIO_LLM_PROVIDER: "anthropic" (Claude via the Anthropic SDK),
# "meta-muse" (Meta Muse via the Meta AI API), or "openai-compatible" (alias
# "openai": OpenAI or any chat-completions API at COHORIO_LLM_BASE_URL, e.g.
# Groq, OpenRouter, Ollama).
# Aliases "meta", "muse" and "meta-ai" also select Meta Muse. Unset, an
# Anthropic key (sk-ant-...) selects anthropic and an api.meta.ai base URL
# selects Meta Muse.
COHORIO_LLM_PROVIDER=anthropic
COHORIO_LLM_API_KEY=
# Model id for the chosen provider. Claude defaults to claude-opus-5-5;
# Meta Muse defaults to muse-wonder-1.0; openai-compatible defaults to
# gpt-4.1-mini and accepts any id the endpoint serves (e.g. gpt-4o,
# llama-3.3-70b-versatile). Price models missing from src/lib/llm/pricing.ts
# with COHORIO_LLM_PRICING_JSON, e.g. {"my-model":{"input":1,"output":3}}.
COHORIO_LLM_MODEL=claude-opus-5-5
# Claude thinking effort: low | medium | high | xhigh | max (default medium).
COHORIO_LLM_EFFORT=medium
# Base URL for meta-muse / openai-compatible. A pathless host gets a /v1 path
# added; anything else (e.g. https://api.groq.com/openai/v1,
# https://openrouter.ai/api/v1) is used as given.
COHORIO_LLM_BASE_URL=https://api.meta.ai/v1
b10_mWthJCmk.sVYjNjmcObz5bJB0ELGdvZyGmh7PG4FB

# Optional OpenAI-compatible image generation for Social Studio "Add a visual".
# Server-only. Leave the key empty to fail closed; post text still generates.
COHORIO_IMAGE_API_KEY=
COHORIO_IMAGE_BASE_URL=https://api.openai.com/v1
COHORIO_IMAGE_MODEL=dall-e-3 muse-image-1.0

# Optional Stripe billing for the Pro ($49/mo) and Team ($149/mo) plans.
# Server-only. With these empty every workspace stays on the free plan.
# Point the Stripe webhook at ${APP_URL}/api/billing/webhook and subscribe to
# checkout.session.completed, customer.subscription.created/updated/deleted
# and invoice.payment_failed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MAILCHIMP_API_KEY=

# Included agent LLM spend per month (USD). Runs over budget are refused.
# COHORIO_AGENT_BUDGET_FREE_USD=1
# COHORIO_AGENT_BUDGET_PRO_USD=50
# COHORIO_AGENT_BUDGET_TEAM_USD=200
# Per-1M-token USD rates for models without a built-in estimate, as JSON:
# COHORIO_LLM_PRICING_JSON={"muse-wonder-1.0":{"input":1.5,"output":6}}

# Background worker for scheduled agent automations and approval emails.
# Runs inside the Next.js server process when true. Keep it off on local dev
# servers that share a database with production. Several instances may run it:
# jobs are claimed with row locks, so each job runs once.
COHORIO_WORKER_ENABLED=false
# Poll interval in milliseconds (minimum 5000).
COHORIO_WORKER_INTERVAL_MS=15000
